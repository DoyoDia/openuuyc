;
; OpenUUYCDisplay.inf
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=OpenUUYCDisplay.cat
DriverVer = 09/29/2026,1.0.0.4

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=OpenUUYCDisplay_Install, ROOT\OPENUUYC_DISPLAY

[SourceDisksFiles]
OpenUUYCDisplay.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[OpenUUYCDisplay_Install.NT]
CopyFiles=UMDriverCopy

[OpenUUYCDisplay_Install.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "OpenUUYCDisplayGroup"
HKR,, "Security",, "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[OpenUUYCDisplay_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[OpenUUYCDisplay_Install.NT.Wdf]
UmdfService=OpenUUYCDisplay,OpenUUYCDisplay_Install
UmdfServiceOrder=OpenUUYCDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[OpenUUYCDisplay_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\OpenUUYCDisplay.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
OpenUUYCDisplay.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="OpenUUYC"
DiskName = "OpenUUYCDisplay Installation Disk"
DeviceName="OpenUUYC Virtual Display Adapter"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
