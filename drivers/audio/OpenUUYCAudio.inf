[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/27/2026,1.0.0.10
CatalogFile=OpenUUYCAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041
[Models.NTamd64.10.0...19041]
%Device%=Install,ROOT\OPENUUYC_AUDIO

[DestinationDirs]
DefaultDestDir=13
[SourceDisksNames]
1=%Device%,,,
[SourceDisksFiles]
OpenUUYCAudio.sys=1
[Install.NT]
Include=ks.inf,kscaptur.inf
Needs=KS.Registration,KSCAPTUR.Registration.NT
CopyFiles=DriverFiles
AddReg=EndpointNames
[EndpointNames]
; Device-local names; never replace the system-wide audio category names.
HKR,MediaCategories\%SpeakerCategory%,Name,,%SpeakerEndpointName%
HKR,MediaCategories\%MicrophoneCategory%,Name,,%MicrophoneEndpointName%
[DriverFiles]
OpenUUYCAudio.sys
[Install.NT.Services]
AddService=OpenUUYCAudio,0x2,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenUUYCAudio.sys
[Install.NT.Wdf]
KmdfService=OpenUUYCAudio,Wdf
[Wdf]
KmdfLibraryVersion=1.31

[Install.NT.Interfaces]
AddInterface=%Audio%,"OpenUUYCSpeaker",SpeakerInterface
AddInterface=%Render%,"OpenUUYCSpeaker",SpeakerInterface
AddInterface=%Realtime%,"OpenUUYCSpeaker",SpeakerInterface
AddInterface=%Audio%,"OpenUUYCMicrophone",MicrophoneInterface
AddInterface=%Capture%,"OpenUUYCMicrophone",MicrophoneInterface
AddInterface=%Realtime%,"OpenUUYCMicrophone",MicrophoneInterface
[SpeakerInterface]
AddReg=SpeakerProperties
[MicrophoneInterface]
AddReg=MicrophoneProperties
[SpeakerProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%SpeakerName%
HKR,EP\0,%Association%,,%SpeakerCategory%
HKR,EP\0,%EndpointIcon%,,"%%SystemRoot%%\system32\mmres.dll,-3010"
HKR,EP\0,%EventDriven%,0x10001,1
[MicrophoneProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%MicrophoneName%
HKR,EP\0,%Association%,,%MicrophoneCategory%
HKR,EP\0,%EndpointIcon%,,"%%SystemRoot%%\system32\mmres.dll,-3014"
HKR,EP\0,%EventDriven%,0x10001,1

