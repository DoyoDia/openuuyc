[Unit]
Description=OpenUUYC 虚拟显示器辅助程序
Requires=openuuyc-vkms.socket
After=openuuyc-vkms.socket

[Service]
Type=simple
ExecStart=/usr/bin/openuuyc-vkms
# 它是套接字激活的：不正常退出后，下一次连接会把它拉起来。
Restart=on-failure

# 这个程序以 root 运行，但只做一件事——按主程序的请求接上/断开内核 VKMS 的一路
# 连接器。下面把它能碰的东西收到 configfs 里的那一处。
# 注意不能设 ProtectKernelModules：加载 vkms 模块正是它的活。
ProtectSystem=strict
ReadWritePaths=/sys/kernel/config/vkms
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
